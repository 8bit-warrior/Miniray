[Unit]
Description=Miniray web panel
Wants=network-online.target
After=network-online.target miniray-core.service miniray-agent.service
StartLimitIntervalSec=180
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/usr/local/miniray
EnvironmentFile=-/etc/default/miniray
Environment=MINIRAY_SEPARATE_CORE=1
ExecStart=/usr/local/miniray/miniray
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
UMask=0077

[Install]
WantedBy=multi-user.target
