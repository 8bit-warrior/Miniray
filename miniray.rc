#!/sbin/openrc-run

command="/usr/local/miniray/miniray"
command_background=true
pidfile="/run/miniray.pid"
description="miniray Service"
procname="miniray"
depend() {
    need net
}
start_pre(){
    cd /usr/local/miniray
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1 $(cat $pidfile)
  eend $?
}